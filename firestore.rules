rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ezemr1996@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function stockUpdateMatchesNewOrder(productId) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId);
      return signedIn()
        && request.resource.data.lastOrderId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastOrderId'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && !exists(orderPath)
        && getAfter(orderPath).data.userId == request.auth.uid
        && getAfter(orderPath).data.stockChanges[productId]
          == resource.data.stock - request.resource.data.stock;
    }

    match /productos/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || stockUpdateMatchesNewOrder(productId);
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'cliente', 'items', 'total', 'fecha', 'userId', 'stockChanges'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cliente is map
        && request.resource.data.cliente.keys().hasAll(['Nombre', 'Direccion', 'email', 'Doc'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.stockChanges is map;
      allow read, update, delete: if isAdmin();
    }
  }
}
